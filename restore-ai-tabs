#!/usr/bin/env python3
"""restore-ai-tabs — 死机/重启后，把 Claude Code 和 Codex 会话一键恢复成 iTerm2 的 tab。

用法:
  restore-ai-tabs              # 复选框界面，选择最近 6 小时的会话
  restore-ai-tabs -H 24        # 看最近 24 小时
  restore-ai-tabs --all        # 不询问，恢复所有没在运行的会话
  restore-ai-tabs --list       # 只列出，不打开
  restore-ai-tabs --dry-run    # 打印将要执行的命令，不打开
  restore-ai-tabs --new-window # 在新窗口打开（默认加到当前窗口）
  restore-ai-tabs --check      # 给 ~/.zshrc 用：iTerm 每次启动后第一次开 shell 时，
                               # 如果有最近中断的会话，就提示是否恢复
"""
import argparse
import curses
import glob
import json
import locale
import os
import shlex
import subprocess
import sys
import time
import unicodedata

__version__ = "0.3.0"
HOME = os.path.expanduser("~")
STATE_FILE = os.path.join(HOME, ".cache/restore-ai-tabs/last-iterm")
CHECK_HOURS = float(os.environ.get("RESTORE_AI_TABS_CHECK_HOURS", 3))


# ---------- 读取会话 ----------

def first_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for b in content:
            if isinstance(b, dict) and b.get("type") in ("text", "input_text"):
                return b.get("text", "")
    return ""


def one_line(s):
    return " ".join(s.split())


def iter_json(path):
    try:
        with open(path, encoding="utf-8", errors="ignore") as fh:
            for line in fh:
                try:
                    yield json.loads(line)
                except ValueError:
                    continue
    except OSError:
        return


def claude_sessions(since):
    out = []
    for f in glob.glob(os.path.join(HOME, ".claude/projects/*/*.jsonl")):
        mtime = os.path.getmtime(f)
        if mtime < since:
            continue
        sid, cwd, title = os.path.basename(f)[:-6], None, ""
        for d in iter_json(f):
            cwd = cwd or d.get("cwd")
            if not title and d.get("type") == "user" and not d.get("isMeta") and not d.get("isSidechain"):
                t = first_text((d.get("message") or {}).get("content")).strip()
                if t and not t.startswith("<"):
                    title = t
            if cwd and title:
                break
        if cwd:
            out.append(dict(tool="claude", id=sid, cwd=cwd, mtime=mtime, title=one_line(title), path=f,
                            cmd="claude --resume " + shlex.quote(sid)))
    return out


def codex_sessions(since):
    out = []
    for f in glob.glob(os.path.join(HOME, ".codex/sessions/*/*/*/rollout-*.jsonl")):
        mtime = os.path.getmtime(f)
        if mtime < since:
            continue
        sid, cwd, title = None, None, ""
        for d in iter_json(f):
            p = d.get("payload") or {}
            if d.get("type") == "session_meta":
                sid, cwd = p.get("id"), p.get("cwd")
            elif not title and d.get("type") == "response_item" and p.get("role") == "user":
                t = first_text(p.get("content")).strip()
                if t and not t.startswith("<"):
                    title = t
            if sid and title:
                break
        if sid and cwd:
            out.append(dict(tool="codex", id=sid, cwd=cwd, mtime=mtime, title=one_line(title), path=f,
                            cmd="codex resume " + shlex.quote(sid)))
    return out


# ---------- 判断哪些会话正在运行 ----------

def running_processes():
    """返回 [(pid, args, cwd)]，只包含 claude / codex 进程。"""
    try:
        ps = subprocess.run(["ps", "-Ao", "pid=,args="], capture_output=True, text=True).stdout
    except OSError:
        return []
    procs = {}
    for line in ps.splitlines():
        pid, _, args = line.strip().partition(" ")
        # 兼容直接运行（claude ...）和经 node 启动（node /.../bin/codex ...）
        if any(os.path.basename(t) in ("claude", "codex") for t in args.split()[:2]):
            procs[pid] = args
    if not procs:
        return []
    cwds = {}
    try:
        out = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fn", "-p", ",".join(procs)],
                             capture_output=True, text=True).stdout
        pid = None
        for line in out.splitlines():
            if line.startswith("p"):
                pid = line[1:]
            elif line.startswith("n") and pid:
                cwds[pid] = line[1:]
    except OSError:
        pass
    return [(pid, args, cwds.get(pid)) for pid, args in procs.items()]


def open_files():
    try:
        out = subprocess.run(["lsof", "-Fn", "+D", os.path.join(HOME, ".codex/sessions")],
                             capture_output=True, text=True).stdout
    except OSError:
        return set()
    return {line[1:] for line in out.splitlines() if line.startswith("n")}


def mark_running(items):
    procs = running_processes()
    opened = open_files()
    for it in items:
        it["running"] = it["path"] in opened or any(it["id"] in args for _, args, _ in procs)
    # 没带会话 ID 启动的 claude：认为它对应同目录下最近活动的那个会话
    for _, args, cwd in procs:
        if os.path.basename(args.split(" ", 1)[0]) != "claude" or not cwd or "--resume" in args:
            continue
        same = [it for it in items if it["tool"] == "claude" and it["cwd"] == cwd]
        if same:
            max(same, key=lambda x: x["mtime"])["running"] = True


# ---------- 显示宽度（中文占两格） ----------

def width(s):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def fit(s, w):
    out, used = "", 0
    for c in s:
        cw = 2 if unicodedata.east_asian_width(c) in "WF" else 1
        if used + cw > w - (1 if len(out) < len(s) else 0):
            return out + "…" + " " * max(0, w - used - 1)
        out += c
        used += cw
    return out + " " * (w - used)


def short_cwd(cwd):
    return "~" + cwd[len(HOME):] if cwd.startswith(HOME) else cwd


def ago(t):
    m = int((time.time() - t) / 60)
    if m < 1:
        return "刚刚"
    if m < 60:
        return "%d分钟前" % m
    return "%d小时前" % (m // 60) if m < 1440 else "%d天前" % (m // 1440)


# ---------- 复选框界面 ----------

HELP = "↑↓ 移动  空格 勾选  a 全选  n 全不选  / 搜索  回车 打开（未勾选时只开当前行）  q 退出"


def picker(stdscr, items):
    curses.curs_set(0)
    curses.use_default_colors()
    for i, c in enumerate([curses.COLOR_CYAN, curses.COLOR_GREEN, curses.COLOR_YELLOW, 8 if curses.COLORS > 8 else curses.COLOR_WHITE], 1):
        curses.init_pair(i, c, -1)
    CYAN, GREEN, YELLOW, GREY = (curses.color_pair(i) for i in range(1, 5))

    checked = set()
    cur, top, query, searching = 0, 0, "", False

    while True:
        vis = [i for i, it in enumerate(items)
               if query.lower() in (it["cwd"] + " " + it["title"] + " " + it["tool"]).lower()]
        cur = max(0, min(cur, len(vis) - 1))
        h, w = stdscr.getmaxyx()
        rows = max(1, h - 5)
        top = min(max(top, cur - rows + 1), cur)

        stdscr.erase()
        stdscr.addnstr(0, 0, "恢复 AI 会话 · 已选 %d / %d" % (len(checked), len(items)), w - 1, curses.A_BOLD)
        stdscr.addnstr(1, 0, ("搜索: " + query + "▏") if searching or query else HELP, w - 1, GREY)

        cwd_w = min(34, max(12, w // 3))
        for row, idx in enumerate(vis[top:top + rows]):
            it, y = items[idx], row + 3
            on_cur = (top + row) == cur
            box = "◉" if idx in checked else "◯"
            tool = "claude" if it["tool"] == "claude" else "codex "
            meta = "运行中" if it["running"] else ago(it["mtime"])
            left = "%s %s %s  %s  " % ("❯" if on_cur else " ", box, tool, fit(short_cwd(it["cwd"]), cwd_w))
            right = "  " + meta
            title_w = max(0, w - 1 - width(left) - width(right))
            attr = curses.A_BOLD if on_cur else 0
            if it["running"]:
                attr |= GREY
            try:
                stdscr.addstr(y, 0, left[:4], (CYAN | curses.A_BOLD) if on_cur else 0)
                stdscr.addstr(y, 2, box, GREEN if idx in checked else GREY)
                stdscr.addstr(y, 4, left[4:], attr | (YELLOW if it["tool"] == "codex" and not it["running"] else 0))
                stdscr.addstr(fit(it["title"] or "（无标题）", title_w), attr)
                stdscr.addstr(right, GREY)
            except curses.error:
                pass
        if not vis:
            stdscr.addnstr(3, 2, "没有匹配的会话", w - 3, GREY)
        stdscr.refresh()

        k = stdscr.get_wch()
        if searching:
            if k in ("\n", "\r", curses.KEY_ENTER, "\x1b"):
                searching = False
                if k == "\x1b":
                    query = ""
            elif k in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                query = query[:-1]
            elif isinstance(k, str) and k.isprintable():
                query, cur = query + k, 0
            continue
        if k in (curses.KEY_UP, "k"):
            cur = max(0, cur - 1)
        elif k in (curses.KEY_DOWN, "j"):
            cur = min(len(vis) - 1, cur + 1)
        elif k == " " and vis:
            checked ^= {vis[cur]}
        elif k == "a":
            checked |= set(vis)
        elif k == "n":
            checked -= set(vis)
        elif k == "/":
            searching = True
        elif k in ("\n", "\r", curses.KEY_ENTER):
            # 没勾选任何会话时，回车只打开光标所在的那一个
            if not checked:
                return [items[vis[cur]]] if vis else []
            return [items[i] for i in sorted(checked)]
        elif k in ("q", "\x1b"):
            return []


# ---------- 打开 iTerm tab ----------

def as_applescript(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def open_tabs(items, new_window):
    lines = ['tell application "iTerm"', "activate"]
    if new_window:
        lines.append("set w to (create window with default profile)")
    else:
        lines += ["if (count of windows) = 0 then",
                  "set w to (create window with default profile)",
                  "else",
                  "set w to current window",
                  "tell w to create tab with default profile",
                  "end if"]
    for i, it in enumerate(items):
        cmd = "cd %s && %s" % (shlex.quote(it["cwd"]), it["cmd"])
        if i > 0:
            lines.append("tell w to create tab with default profile")
        lines.append("tell current session of w")
        lines.append("set name to %s" % as_applescript(os.path.basename(it["cwd"].rstrip("/")) or "~"))
        lines.append("write text %s" % as_applescript(cmd))
        lines.append("end tell")
    lines.append("end tell")
    subprocess.run(["osascript", "-e", "\n".join(lines)], check=True)


# ---------- 启动提醒 ----------

def iterm_launch_id():
    """当前 iTerm2 进程的 "pid + 启动时间"，用来保证每次启动 iTerm 只提醒一次。"""
    out = subprocess.run(["ps", "-Ao", "pid=,lstart=,comm="], capture_output=True, text=True).stdout
    for line in out.splitlines():
        if line.rstrip().endswith("MacOS/iTerm2"):
            return line.rsplit(" ", 1)[0].strip()
    return None


def first_check_since_launch():
    launch = iterm_launch_id()
    if not launch:
        return False
    try:
        with open(STATE_FILE) as fh:
            if fh.read().strip() == launch:
                return False
    except OSError:
        pass
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE, "w") as fh:
        fh.write(launch)
    return True


def read_key():
    import termios
    import tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        return sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def check():
    if not sys.stdin.isatty() or not first_check_since_launch():
        return
    since = time.time() - CHECK_HOURS * 3600
    items = claude_sessions(since) + codex_sessions(since)
    if not items:
        return
    mark_running(items)
    stopped = [it for it in items if not it["running"]]
    if not stopped:
        return
    print("\033[36m⟲ 发现 %d 个最近 %g 小时内中断的 Claude / Codex 会话。\033[0m"
          "回车 = 选择恢复，其他键 = 跳过（之后可随时运行 restore-ai-tabs）" % (len(stopped), CHECK_HOURS))
    if read_key() not in ("\n", "\r"):
        return
    items.sort(key=lambda x: -x["mtime"])
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    chosen = curses.wrapper(picker, items)
    if chosen:
        open_tabs(chosen, new_window=False)
        print("已在 iTerm 打开 %d 个 tab。" % len(chosen))


def main():
    ap = argparse.ArgumentParser(description="在 iTerm2 里一键恢复最近的 Claude Code / Codex 会话")
    ap.add_argument("-H", "--hours", type=float, default=6, help="查看最近多少小时的会话（默认 6）")
    ap.add_argument("--all", action="store_true", help="不询问，恢复所有没在运行的会话")
    ap.add_argument("--list", action="store_true", help="只列出会话，不打开")
    ap.add_argument("--dry-run", action="store_true", help="打印将要执行的命令，不打开")
    ap.add_argument("--new-window", action="store_true", help="在新窗口打开（默认加到当前窗口）")
    ap.add_argument("--check", action="store_true", help="iTerm 启动后首次调用时，如有中断的会话就提示恢复（放在 ~/.zshrc 里）")
    ap.add_argument("-V", "--version", action="version", version=__version__)
    args = ap.parse_args()

    if args.check:
        try:
            check()
        except (Exception, KeyboardInterrupt):
            pass  # 提醒失败不能影响正常开 shell
        return

    since = time.time() - args.hours * 3600
    items = sorted(claude_sessions(since) + codex_sessions(since), key=lambda x: -x["mtime"])
    if not items:
        print("最近 %g 小时没有 Claude / Codex 会话，可以用 -H 24 看更久的。" % args.hours)
        return
    mark_running(items)

    if args.list:
        for it in items:
            print("%-6s  %-8s  %s  %s" % (it["tool"], "运行中" if it["running"] else ago(it["mtime"]),
                                         short_cwd(it["cwd"]), it["title"][:60]))
        return
    if args.all:
        chosen = [it for it in items if not it["running"]]
    elif not sys.stdin.isatty():
        sys.exit("需要在终端里交互运行，或加 --all / --list")
    else:
        locale.setlocale(locale.LC_ALL, "")
        os.environ.setdefault("ESCDELAY", "25")
        chosen = curses.wrapper(picker, items)

    if not chosen:
        print("没有选择任何会话。")
        return
    if args.dry_run:
        for it in chosen:
            print("cd %s && %s" % (shlex.quote(it["cwd"]), it["cmd"]))
        return
    open_tabs(chosen, args.new_window)
    print("已在 iTerm 打开 %d 个 tab。" % len(chosen))


if __name__ == "__main__":
    main()
